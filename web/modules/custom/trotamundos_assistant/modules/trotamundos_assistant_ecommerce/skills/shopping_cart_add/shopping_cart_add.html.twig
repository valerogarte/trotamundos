{#
/**
 * @file
 * Shopping cart add confirmation template for Trotamundos Assistant.
 */
#}
<article class="trotamundos-assistant-template trotamundos-assistant-template--shopping-cart">
  <header class="trotamundos-assistant-template__header">
    <p class="trotamundos-assistant-template__eyebrow">{{ title|default('Añadir al carrito'|t) }}</p>
  </header>

  {% if intro is defined and intro %}
    <p class="trotamundos-assistant-template__intro">{{ intro }}</p>
  {% elseif description is defined and description %}
    <p class="trotamundos-assistant-template__description">{{ description }}</p>
  {% endif %}

  {% if product_items is defined and product_items %}
    <div class="trotamundos-assistant-cart__notice" role="status">
      <span class="trotamundos-assistant-cart__notice-icon" aria-hidden="true">!</span>
      <div>
        <strong>{{ 'Confirmación necesaria'|t }}</strong>
        <span>{{ 'El asistente ha preparado la acción, pero el producto no se añadirá hasta que pulses el botón de confirmación.'|t }}</span>
      </div>
    </div>

    <div class="trotamundos-assistant-template__grid">
      {% for item in product_items %}
        <article class="product-card minsait-skill-product-card minsait-skill-product-card--confirm">
          <div class="minsait-skill-product-card__media">
            {% if item.product_id is defined and item.product_id %}
              <button
                type="button"
                class="minsait-skill-product-card__favorite{{ item.is_favorite ? ' is-favorite' }}"
                aria-label="{{ item.is_favorite ? 'Quitar de favoritos'|t : 'Añadir a favoritos'|t }}"
                aria-pressed="{{ item.is_favorite ? 'true' : 'false' }}"
                data-minsait-skill-favorite-toggle
                data-favorite-url="{{ item.favorite_toggle_url|default('') }}"
                data-favorite-login-url="{{ item.favorite_login_url|default('/user/login') }}"
                data-is-favorite="{{ item.is_favorite ? '1' : '0' }}"
              >
                <span aria-hidden="true">{{ item.is_favorite ? '♥' : '♡' }}</span>
              </button>
            {% endif %}
            {% if item.image_url is defined and item.image_url %}
              <img src="{{ item.image_url }}" alt="{{ item.image_alt|default(item.title) }}" loading="lazy" />
            {% else %}
              <span class="minsait-skill-product-card__placeholder" aria-hidden="true"></span>
            {% endif %}
          </div>

          <div class="minsait-skill-product-card__content">
            <span class="trotamundos-assistant-cart__status">{{ 'Pendiente de confirmar'|t }}</span>
            <div class="minsait-skill-product-card__meta">
              {% if item.store_name is defined and item.store_name %}
                <a class="minsait-skill-product-card__store" href="{{ item.store_url|default('#') }}">{{ item.store_name }}</a>
              {% else %}
                <span class="minsait-skill-product-card__store">{{ 'Producto'|t }}</span>
              {% endif %}
              <span class="minsait-skill-product-card__rating">
                <span aria-hidden="true">☆</span>
                {% if item.rating is defined and item.rating > 0 %}
                  {{ item.rating|number_format(1, ',', '.') }}
                {% else %}
                  {{ 'Sin valorar'|t }}
                {% endif %}
              </span>
            </div>
            {% if item.title %}
              <h3 class="minsait-skill-product-card__title">
                <a href="{{ item.product_url|default('#') }}">{{ item.title }}</a>
              </h3>
            {% endif %}
            {% if item.body %}
              <p class="minsait-skill-product-card__summary">{{ item.body }}</p>
            {% endif %}
            <div class="minsait-skill-product-card__footer minsait-skill-product-card__footer--confirm">
              <div class="minsait-skill-product-card__purchase">
                <span class="minsait-skill-product-card__price">{{ item.price|default('Consultar'|t) }}</span>
                <span class="minsait-skill-product-card__quantity">{{ 'Cantidad: @quantity'|t({ '@quantity': item.quantity|default(1) }) }}</span>
              </div>
              {% if item.add_to_cart_url is defined and item.add_to_cart_url and item.variation_id is defined and item.variation_id %}
                <button
                  class="trotamundos-assistant-cart__button"
                  type="button"
                  data-minsait-skill-add-to-cart
                  data-add-to-cart-url="{{ item.add_to_cart_url }}"
                  data-variation-id="{{ item.variation_id }}"
                  data-quantity="{{ item.quantity|default(1) }}"
                >
                  {{ 'Confirmar y añadir'|t }}
                </button>
              {% else %}
                <a class="trotamundos-assistant-cart__link" href="{{ item.product_url|default('#') }}">{{ 'Ver producto'|t }}</a>
              {% endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="trotamundos-assistant-cart__actions">
      <a
        class="trotamundos-assistant-cart__link"
        href="{{ path('commerce_cart.page') }}"
        data-trotamundos-assistant-cart-panel
        data-cart-panel-url="{{ path('trotamundos_assistant.skill_action', {'machine_name': 'shopping_cart_view', 'action': 'panel'}) }}"
      >
        {{ 'Ver carrito'|t }}
      </a>
    </div>
  {% else %}
    <div class="trotamundos-assistant-template__empty">
      <p>{{ 'No he podido preparar ningún producto para añadir al carrito.'|t }}</p>
    </div>
  {% endif %}

  {% include '@trotamundos_assistant/trotamundos-assistant-suggestions.html.twig' with { notes: notes|default(''), outro: outro|default('') } only %}
</article>
