  $schema['trotamundos_assistant_usage'] = [
    'description' => 'Stores AI provider usage and estimated cost for Trotamundos Assistant calls.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'call_id' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'Identifier for the frontend assistant request.',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Unix timestamp when the provider call was recorded.',
      ],
      'uid' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'thread_id' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'assistant_id' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'provider_request_id' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'provider_id' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'model_id' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'operation_type' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ],
      'iteration_number' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Conversation iteration number inside the thread.',
      ],
      'input_tokens' => [
        'type' => 'int',
        'not null' => FALSE,
      ],
      'output_tokens' => [
        'type' => 'int',
        'not null' => FALSE,
      ],
      'total_tokens' => [
        'type' => 'int',
        'not null' => FALSE,
      ],
      'cached_tokens' => [
        'type' => 'int',
        'not null' => FALSE,
      ],
      'reasoning_tokens' => [
        'type' => 'int',
        'not null' => FALSE,
      ],
      'input_cost_usd' => [
        'type' => 'numeric',
        'precision' => 18,
        'scale' => 10,
        'not null' => TRUE,
        'default' => '0',
      ],
      'output_cost_usd' => [
        'type' => 'numeric',
        'precision' => 18,
        'scale' => 10,
        'not null' => TRUE,
        'default' => '0',
      ],
      'cached_cost_usd' => [
        'type' => 'numeric',
        'precision' => 18,
        'scale' => 10,
        'not null' => TRUE,
        'default' => '0',
      ],
      'total_cost_usd' => [
        'type' => 'numeric',
        'precision' => 18,
        'scale' => 10,
        'not null' => TRUE,
        'default' => '0',
      ],
      'currency' => [
        'type' => 'varchar',
        'length' => 3,
        'not null' => TRUE,
        'default' => 'USD',
      ],
      'pricing_source' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'request_text' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'Text sent by the user for this assistant request.',
      ],
      'response_text' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'Full text returned by the assistant for this request.',
      ],
      'provider_request_raw' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'Raw request input captured from the AI provider event.',
      ],
      'provider_system_prompt' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'Final system prompt sent to the AI provider, including skill instructions.',
      ],
      'provider_response_raw' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'Raw response output captured from the AI provider event.',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'call_id' => ['call_id'],
      'thread_id' => ['thread_id'],
      'iteration_number' => ['thread_id', 'iteration_number'],
      'created' => ['created'],
      'uid' => ['uid'],
    ],
