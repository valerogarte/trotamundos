/**
 * Creates the usage tracking table on installs that predate its schema.
 */
function trotamundos_assistant_update_11028(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('trotamundos_assistant_usage')) {
    $tables = trotamundos_assistant_schema();
    $schema->createTable('trotamundos_assistant_usage', $tables['trotamundos_assistant_usage']);
  }
}

/**
 * Migrates the usage table and schema state from the former module name.
 */
function trotamundos_assistant_update_11029(): void {
  trotamundos_assistant_migrate_usage_table();
}

/**
 * Stores the final system prompt for provider-call auditing.
 */
function trotamundos_assistant_update_11030(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('trotamundos_assistant_usage') || $schema->fieldExists('trotamundos_assistant_usage', 'provider_system_prompt')) {
    return;
  }

  $schema->addField('trotamundos_assistant_usage', 'provider_system_prompt', [
    'type' => 'text',
    'size' => 'big',
    'not null' => FALSE,
    'description' => 'Final system prompt sent to the AI provider, including skill instructions.',
  ]);
}

/**
 * Renames the usage table and removes obsolete schema state.
 */
function trotamundos_assistant_migrate_usage_table(): void {
  $schema = \Drupal::database()->schema();

  if (!$schema->tableExists('trotamundos_assistant_usage')) {
    if ($schema->tableExists('minsait_assistant_usage')) {
      $schema->renameTable('minsait_assistant_usage', 'trotamundos_assistant_usage');
    }
    else {
      // Sites that adopted the schema version without ever running
      // hook_schema() (machine-name change) end up with no usage table at all.
      $tables = trotamundos_assistant_schema();
      $schema->createTable('trotamundos_assistant_usage', $tables['trotamundos_assistant_usage']);
    }
  }

  \Drupal::keyValue('system.schema')->deleteMultiple([
    'minsait_assistant',
    'minsait_assistant_documents',
    'minsait_assistant_ecommerce',
  ]);
}

/**
 * Re-runs usage table migration on sites where the machine-name change skipped it.
 */
function trotamundos_assistant_update_11031(): void {
  trotamundos_assistant_migrate_usage_table();
}
