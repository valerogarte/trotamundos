  return $schema;
}

/**
 * Implements hook_update_last_removed().
 */
function trotamundos_assistant_update_last_removed(): int {
  return 11012;
}

/**
 * Splits the shopping cart skill into view and add skills.
 */
function trotamundos_assistant_update_11013(): void {
  $config = \Drupal::configFactory()->getEditable('trotamundos_assistant.settings');
  $enabled_skills = $config->get('enabled_skills');
  if (!is_array($enabled_skills)) {
    return;
  }

  $updated = [];
  foreach ($enabled_skills as $skill) {
    $skill = (string) $skill;
    if ($skill === 'shopping_cart') {
      $updated[] = 'shopping_cart_add';
      $updated[] = 'shopping_cart_view';
      continue;
    }
    $updated[] = $skill;
  }

  $config
    ->set('enabled_skills', array_values(array_unique($updated)))
    ->save();
}

/**
 * Adds role restriction defaults for assistant access.
 */
function trotamundos_assistant_update_11014(): void {
  $config = \Drupal::configFactory()->getEditable('trotamundos_assistant.settings');
  $defaults = [
    'allowed_roles' => ['administrator'],
    'login_required_message' => 'Para usar el asistente de catálogo debes estar logado.',
    'role_denied_chat_message' => 'No tienes permisos para usar este asistente.',
  ];

  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }

  $config->save();
}

/**
 * Removes the duplicated anonymous chat message setting.
 */
function trotamundos_assistant_update_11015(): void {
  \Drupal::configFactory()
    ->getEditable('trotamundos_assistant.settings')
    ->clear('login_required_chat_message')
    ->save();
}

/**
 * Leaves only the default skill enabled by default.
 */
function trotamundos_assistant_update_11016(): void {
  \Drupal::configFactory()
    ->getEditable('trotamundos_assistant.settings')
    ->set('enabled_skills', ['default'])
    ->save();
}

/**
 * Moves ecommerce skill configuration to the ecommerce submodule namespace.
 */
function trotamundos_assistant_update_11017(): void {
  if (!\Drupal::moduleHandler()->moduleExists('trotamundos_assistant_ecommerce')) {
    \Drupal::service('module_installer')->install(['trotamundos_assistant_ecommerce']);
  }

  $ecommerce_skills = [
    'clarification',
    'payment',
    'product_alternatives',
    'product_comparison',
    'product_recommendations',
    'product_results',
    'product_summary',
    'shopping_cart_add',
    'shopping_cart_view',
  ];
  $ecommerce_lookup = array_fill_keys($ecommerce_skills, TRUE);
  $config = \Drupal::configFactory()->getEditable('trotamundos_assistant.settings');
  $enabled_skills = $config->get('enabled_skills');
  if (!is_array($enabled_skills)) {
    return;
  }

  $updated = [];
  foreach ($enabled_skills as $skill) {
    $skill = (string) $skill;
    $updated[] = isset($ecommerce_lookup[$skill])
      ? 'trotamundos_assistant_ecommerce:' . $skill
      : $skill;
  }

  $config
    ->set('enabled_skills', array_values(array_unique($updated)))
    ->save();
}

/**
 * Adds external result panel configuration defaults.
 */
function trotamundos_assistant_update_11018(): void {
  $config = \Drupal::configFactory()->getEditable('trotamundos_assistant.settings');
  $defaults = [
    'result_target_selector' => '#trotamundos-assistant-result-panel',
    'desktop_always_open' => FALSE,
  ];

  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }

  $config->save();
}

