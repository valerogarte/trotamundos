{#
/**
 * @file
 * Catalog filters belong to the shared header form, including without JS.
 */
#}
{% import '@trotamundos/components/icons.html.twig' as icons %}
{% set editorial_catalog = product_type is not empty %}
<div class="catalog{{ editorial_catalog ? ' catalog--editorial' : '' }}" data-catalog>
  {% if editorial_catalog %}
    <h1 class="visually-hidden">{{ catalog_title }}</h1>
  {% else %}
  <header class="page-intro container">
    <p class="eyebrow">{{ 'Catálogo'|t }}</p>
    <h1>{{ catalog_title }}</h1>
    <p class="lead">{{ 'Planes con anfitriones locales en destinos poco conocidos de Colombia. Filtra por lo que te gustaría descubrir, el destino, tu presupuesto o la fecha.'|t }}</p>
  </header>
  {% endif %}

  <p class="visually-hidden" role="status" aria-live="polite" data-catalog-status data-loading-message="{{ 'Cargando planes...'|t }}" data-timeout-message="{{ 'La carga está tardando demasiado. Puedes volver a intentarlo.'|t }}" data-error-message="{{ 'No se pudieron cargar los planes. Vuelve a intentarlo.'|t }}"></p>
  <section class="catalog-results container" aria-labelledby="catalog-results-title" data-catalog-results>
    <h2 id="catalog-results-title" class="visually-hidden">
      {% set count = total %}
      {% if product_type == 'alojamiento' %}
        {% trans %}1 alojamiento{% plural count %}{{ count }} alojamientos{% endtrans %}
      {% elseif product_type == 'paquete' %}
        {% trans %}1 paquete{% plural count %}{{ count }} paquetes{% endtrans %}
      {% elseif product_type == 'experiencia' %}
        {% trans %}1 experiencia{% plural count %}{{ count }} experiencias{% endtrans %}
      {% else %}
        {% trans %}1 plan{% plural count %}{{ count }} planes{% endtrans %}
      {% endif %}
    </h2>
    {% if active %}
      <ul class="active-filters" aria-label="{{ 'Filtros activos'|t }}">
        {% for item in active %}
          <li><a href="{{ item.remove_url }}"><span class="visually-hidden">{{ 'Quitar el filtro'|t }}</span> {{ item.label }} {{ icons.icon('close') }}</a></li>
        {% endfor %}
        <li><a class="active-filters__reset" href="{{ reset_url }}">{{ 'Quitar todos'|t }}</a></li>
      </ul>
    {% endif %}

    {% if cards %}
      <div class="experience-grid experience-grid--four" data-catalog-grid>
        {% for card in cards %}
          {% include '@trotamundos/components/experience-card.html.twig' with {card: card, heading: 'h3'} %}
        {% endfor %}
      </div>
      {{ pager }}
    {% else %}
      <div class="experience-grid experience-grid--four catalog-skeleton-fallback" aria-hidden="true">
        {% for i in 1..skeleton_count %}
          <div class="experience-card">
            <div class="experience-card__media"></div>
            <div class="experience-card__body"></div>
          </div>
        {% endfor %}
      </div>
      <div class="empty-state">
        <h3>{{ 'No encontramos planes con esos filtros'|t }}</h3>
        <p>{{ 'Prueba con otra fecha o quita algún filtro. Si buscas algo concreto, cuéntanos y te ayudamos a encontrarlo.'|t }}</p>
        <div class="empty-state__actions">
          <a class="button button--secondary" href="{{ reset_url }}" data-catalog-reset>{{ 'Quitar filtros'|t }}</a>
          <a class="button button--whatsapp" href="{{ tm.whatsapp_url }}" target="_blank" rel="noopener">{{ icons.icon('whatsapp') }} {{ 'Cuéntanos qué buscas'|t }}<span class="visually-hidden"> ({{ 'se abre en una pestaña nueva'|t }})</span></a>
        </div>
      </div>
    {% endif %}
  </section>

  <section class="container catalog-help" aria-labelledby="catalog-help-title">
    <div>
      <h2 id="catalog-help-title">{{ '¿No sabes cuál elegir?'|t }}</h2>
      <p>{{ 'Cuéntanos qué te gustaría vivir, con quién viajas y en qué fechas, y te recomendamos la experiencia ideal.'|t }}</p>
    </div>
    <a class="button button--whatsapp" href="{{ tm.whatsapp_url }}" target="_blank" rel="noopener">{{ icons.icon('whatsapp') }} {{ 'Pedir una recomendación'|t }}<span class="visually-hidden"> ({{ 'se abre en una pestaña nueva'|t }})</span></a>
  </section>
</div>
