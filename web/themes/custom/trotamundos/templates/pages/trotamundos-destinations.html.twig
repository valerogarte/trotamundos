{#
/**
 * @file
 * Destinations by region > department > municipality. Works the same with a
 * handful of places or with many: regions without experiences go last.
 */
#}
{% import '@trotamundos/components/icons.html.twig' as icons %}
<div class="destinations-page">
  <header class="page-intro container">
    <p class="eyebrow">{{ 'Destinos'|t }}</p>
    <h1>{{ 'Explora Colombia'|t }} <em>{{ 'por destino'|t }}</em></h1>
    <p class="lead">{{ 'Busca experiencias por región, departamento y municipio. Cada destino reúne los planes que preparamos con sus anfitriones.'|t }}</p>
    {% if tree|length > 1 %}
      <nav class="region-index" aria-label="{{ 'Regiones'|t }}">
        {% for region in tree %}
          <a class="filter-button" href="#region-{{ region.key }}">{{ region.label }}</a>
        {% endfor %}
      </nav>
    {% endif %}
  </header>

  {% for region in tree %}
    <section class="region container" id="region-{{ region.key }}" aria-labelledby="region-{{ region.key }}-title">
      <div class="region__heading">
        <h2 id="region-{{ region.key }}-title">{{ region.label }}</h2>
        <p>
          {% if region.count %}
            {% set count = region.count %}
            <span>{% trans %}1 experiencia{% plural count %}{{ count }} experiencias{% endtrans %}</span>
            <a class="text-link" href="{{ catalog_url }}?region={{ region.key }}">{{ 'Ver experiencias de la región'|t }} {{ icons.icon('arrow') }}</a>
          {% else %}
            <span>{{ 'Próximamente'|t }}</span>
          {% endif %}
        </p>
      </div>

      {% for department in region.departments %}
        <div class="department">
          <div class="department__heading">
            <h3>{{ department.label }}</h3>
            {% if department.count %}
              <a class="text-link" href="{{ catalog_url }}?destino={{ department.slug }}">
                {% set count = department.count %}
                {% set department_name = department.label %}
                {% trans %}Ver 1 experiencia en {{ department_name }}{% plural count %}Ver {{ count }} experiencias en {{ department_name }}{% endtrans %}
                {{ icons.icon('arrow') }}
              </a>
            {% endif %}
          </div>
          <ul class="destination-grid">
            {% for destination in department.destinations %}
              <li>
                <a class="destination-card{{ destination.count ? '' : ' destination-card--soon' }}" href="{{ destination.url }}">
                  <span class="destination-card__media">
                    {% if destination.image %}
                      <img src="{{ destination.image.src }}" alt="" width="{{ destination.image.width }}" height="{{ destination.image.height }}" loading="lazy" decoding="async">
                    {% endif %}
                    <span class="destination-card__count">
                      {% if destination.count %}
                        {% set count = destination.count %}
                        {% trans %}1 experiencia{% plural count %}{{ count }} experiencias{% endtrans %}
                      {% else %}
                        {{ 'Próximamente'|t }}
                      {% endif %}
                    </span>
                  </span>
                  <span class="destination-card__body">
                    <span class="destination-card__name">{{ destination.place }}</span>
                    <span class="destination-card__location">{{ icons.icon('pin') }} {{ destination.municipality }} · {{ destination.department }}</span>
                    {% if destination.summary %}<span class="destination-card__summary">{{ destination.summary }}</span>{% endif %}
                  </span>
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endfor %}
    </section>
  {% else %}
    <div class="container"><p class="empty-state">{{ 'Estamos preparando los primeros destinos.'|t }}</p></div>
  {% endfor %}
</div>
