{#
/**
 * @file
 * Home: video, quick search, experiences first, then purpose, destinations,
 * local commitment and an easy way to ask.
 */
#}
{% import '@trotamundos/components/icons.html.twig' as icons %}
{{ attach_library('trotamundos/front') }}
{% include '@trotamundos/components/header.html.twig' with {header_overlay: true} %}
<main id="main-content" tabindex="-1">
  {% include '@trotamundos/components/immersive-hero.html.twig' %}

  {% if page.highlighted %}<div class="container site-messages front-messages">{{ page.highlighted }}</div>{% endif %}

  <section class="home-experiences container" id="experiencias" aria-label="{{ 'Planes'|t }}">
    {% if tm_styles %}
      {% set style_images = {
        'pueblos-con-alma': 'concepcion-calle.webp',
        'cafe-y-tradicion': 'concepcion-cafe.webp',
        'naturaleza': 'termales-aerea.webp',
        'gastronomia': 'mesa-concepcion.webp',
        'aventura': 'termales-cascada.webp',
        'bienestar': 'termales-bienestar.webp',
        'cultura-viva': 'comunidad-concepcion.webp'
      } %}
      <div class="travel-styles" data-trotamundos-slider data-slider-loop>
        <div class="travel-styles__heading">
          <h2 class="travel-styles__title" id="travel-styles-title">{{ 'Una Colombia por descubrir'|t }}</h2>
          <div class="slider-controls travel-styles__controls" data-slider-controls hidden>
            <button class="button button--secondary" type="button" data-slider-scroll="-1" aria-controls="travel-styles-track" aria-label="{{ 'Estilos anteriores'|t }}">{{ icons.icon('arrow-left') }}</button>
            <button class="button button--secondary" type="button" data-slider-scroll="1" aria-controls="travel-styles-track" aria-label="{{ 'Más estilos de viaje'|t }}">{{ icons.icon('arrow') }}</button>
          </div>
        </div>
        <div class="travel-styles__viewport" data-slider-viewport>
          <ul class="travel-styles__track" id="travel-styles-track" tabindex="0" aria-labelledby="travel-styles-title" data-slider-track>
            {% for style in tm_styles %}
              <li>
                <a class="travel-style" href="{{ path('trotamundos_experiences.catalog', {}, {query: {estilo: style.slug}}) }}">
                  <img class="travel-style__image" src="{{ trotamundos_path }}/assets/images/{{ style_images[style.slug]|default('concepcion-panoramica.webp') }}" alt="" loading="lazy" decoding="async">
                  <span class="travel-style__icon">{{ icons.icon(style.icon) }}</span>
                  <span class="travel-style__label">{{ style.label }}</span>
                  <span class="travel-style__count">
                    {% if style.count %}
                      {% set count = style.count %}
                      {% trans %}1 plan{% plural count %}{{ count }} planes{% endtrans %}
                    {% else %}
                      {{ 'Próximamente'|t }}
                    {% endif %}
                  </span>
                  {{ icons.icon('arrow') }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    {% endif %}
    {% if tm_featured %}
      <h2 class="home-experiences__title">{{ 'Viajes que dejan algo bueno'|t }}</h2>
      {# The last slot of the grid invites to the full catalog instead of a plan. #}
      <div class="experience-grid experience-grid--four">
        {% for card in tm_featured|length > 7 ? tm_featured|slice(0, 7) : tm_featured %}
          {% include '@trotamundos/components/experience-card.html.twig' with {card: card} %}
        {% endfor %}
        <a class="experience-more" href="{{ tm.catalog_url }}">
          <span class="experience-more__eyebrow">{{ 'Hay mucho más por vivir'|t }}</span>
          <span class="experience-more__title">{{ 'Conocer más planes'|t }}</span>
          <span class="experience-more__text">{{ 'Alojamientos, experiencias y paquetes con anfitriones locales en toda Colombia.'|t }}</span>
          <span class="experience-more__arrow" aria-hidden="true">{{ icons.icon('arrow') }}</span>
        </a>
      </div>
    {% else %}
      <div class="empty-state">
        <h3>{{ 'Estamos preparando las primeras experiencias'|t }}</h3>
        <p>{{ 'Escríbenos y te contamos qué destinos están por llegar.'|t }}</p>
        <a class="button button--whatsapp" href="{{ tm.whatsapp_url }}" target="_blank" rel="noopener">{{ icons.icon('whatsapp') }} {{ 'Escríbenos por WhatsApp'|t }}</a>
      </div>
    {% endif %}
  </section>

  <section class="purpose" id="esencia" aria-labelledby="purpose-title">
    <div class="container purpose__inner">
      <div class="purpose__visual" data-reveal>
        <figure class="purpose__arch">
          <img src="{{ trotamundos_path }}/assets/images/comunidad-concepcion.webp" alt="{{ 'Una vecina de Concepción en el corredor de su casa, entre geranios.'|t }}" width="825" height="1100" loading="lazy" decoding="async">
        </figure>
        <figure class="purpose__postcard">
          <img src="{{ trotamundos_path }}/assets/images/termales-manantial.webp" alt="" width="480" height="640" loading="lazy" decoding="async">
          <figcaption>{{ 'Nariño, Antioquia'|t }}</figcaption>
        </figure>
      </div>
      <div class="purpose__copy" data-reveal>
        <p class="eyebrow">{{ 'Nuestra esencia'|t }}</p>
        <h2 id="purpose-title">{{ 'Viajar bonito.'|t }}<br><em>{{ 'Sentir de verdad.'|t }}</em></h2>
        <p class="lead">{{ 'Descubrimos destinos poco conocidos de Colombia junto a quienes los cuidan. Cada viaje apoya a emprendedores turísticos y genera oportunidades para las comunidades locales.'|t }}</p>
        <ul class="purpose__pillars">
          <li>{{ icons.icon('map') }}<div><h3>{{ 'Destinos por descubrir'|t }}</h3><p>{{ 'Pueblos, ríos y montañas que todavía no aparecen en todas las guías.'|t }}</p></div></li>
          <li>{{ icons.icon('heart') }}<div><h3>{{ 'Emprendedores locales'|t }}</h3><p>{{ 'Trabajamos directamente con las familias y los negocios que reciben a los viajeros.'|t }}</p></div></li>
          <li>{{ icons.icon('sprout') }}<div><h3>{{ 'Viajes que dejan algo bueno'|t }}</h3><p>{{ 'Tu reserva genera ingresos y oportunidades en las comunidades que visitas.'|t }}</p></div></li>
        </ul>
        <a class="button button--secondary" href="{{ tm.esencia_url }}">{{ 'Conoce nuestra esencia'|t }} {{ icons.icon('arrow') }}</a>
      </div>
    </div>
  </section>

  {% if tm_destinations %}
    <section class="home-destinations container" aria-labelledby="destinations-title" data-trotamundos-slider data-slider-loop>
      <div class="section-heading">
        <div>
          <p class="eyebrow">{{ 'Destinos'|t }}</p>
          <h2 id="destinations-title">{{ 'Explora Colombia'|t }} <em>{{ 'por destino'|t }}</em></h2>
        </div>
        <div class="home-destinations__actions">
          <a class="text-link" href="{{ tm.destinations_url }}">{{ 'Ver todos los destinos'|t }} {{ icons.icon('arrow') }}</a>
          <div class="slider-controls" data-slider-controls hidden>
            <button class="button button--secondary" type="button" data-slider-scroll="-1" aria-controls="home-destinations-track" aria-label="{{ 'Destinos anteriores'|t }}">{{ icons.icon('arrow-left') }}</button>
            <button class="button button--secondary" type="button" data-slider-scroll="1" aria-controls="home-destinations-track" aria-label="{{ 'Más destinos'|t }}">{{ icons.icon('arrow') }}</button>
          </div>
        </div>
      </div>
      <div class="home-destinations__viewport" data-slider-viewport>
        <ul class="destination-strip" id="home-destinations-track" tabindex="0" aria-labelledby="destinations-title" data-slider-track>
          {% for destination in tm_destinations %}
            <li>
              <a class="destination-chip{{ destination.count ? '' : ' destination-chip--soon' }}" href="{{ destination.url }}">
                {% if destination.image %}<img src="{{ destination.image.src }}" alt="" width="{{ destination.image.width }}" height="{{ destination.image.height }}" loading="lazy" decoding="async">{% endif %}
                <span class="destination-chip__copy">
                  <span class="destination-chip__name">{{ destination.place }}</span>
                  <span class="destination-chip__department">{{ destination.department }}</span>
                  <span class="destination-chip__count">
                    {% if destination.count %}
                      {% set count = destination.count %}
                      {% trans %}1 plan{% plural count %}{{ count }} planes{% endtrans %}
                    {% else %}
                      {{ 'Próximamente'|t }}
                    {% endif %}
                  </span>
                </span>
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </section>
  {% endif %}

  <section class="home-people" aria-labelledby="people-title">
    <div class="container home-people__inner">
      <figure class="home-people__photo" data-reveal>
        <img src="{{ trotamundos_path }}/assets/images/mesa-concepcion.webp" alt="{{ 'Una mesa con comida local y flores en Concepción.'|t }}" width="825" height="1100" loading="lazy" decoding="async">
      </figure>
      <div class="home-people__copy" data-reveal>
        <p class="eyebrow">{{ 'Nuestro compromiso'|t }}</p>
        <h2 id="people-title">{{ 'Detrás de cada viaje,'|t }}<br><em>{{ 'hay una comunidad.'|t }}</em></h2>
        <p class="lead">{{ 'Queremos que descubrir Colombia también signifique reconocer a quienes la hacen única: familias anfitrionas, guías, cocineras y emprendedores que comparten su territorio y sus saberes.'|t }}</p>
        <p class="home-people__commitment">{{ 'Nuestro compromiso es dar visibilidad a sus proyectos, promover encuentros respetuosos y acercarte a propuestas con identidad local. Viajar con curiosidad, escuchar y cuidar también forman parte del camino.'|t }}</p>
        <a class="text-link" href="{{ tm.compromiso_url }}">{{ 'Conoce nuestro compromiso'|t }} {{ icons.icon('arrow') }}</a>
      </div>
    </div>
    <div class="container">
      {% include '@trotamundos/components/trust-strip.html.twig' %}
    </div>
  </section>

  <section class="closing container" aria-labelledby="closing-title" data-reveal>
    <h2 id="closing-title">{{ 'Una Colombia por descubrir.'|t }}<br><em>{{ 'Muchas historias por impulsar.'|t }}</em></h2>
    <p class="lead">{{ '¿Tienes dudas o buscas algo especial? Escríbenos y te ayudamos a elegir.'|t }}</p>
    <div class="closing__actions">
      <a class="button button--primary" href="{{ tm.catalog_url }}">{{ 'Ver planes'|t }} {{ icons.icon('arrow') }}</a>
      <a class="button button--whatsapp" href="{{ tm.whatsapp_url }}" target="_blank" rel="noopener">{{ icons.icon('whatsapp') }} {{ 'Escríbenos por WhatsApp'|t }}<span class="visually-hidden"> ({{ 'se abre en una pestaña nueva'|t }})</span></a>
    </div>
    <svg class="closing__flower" viewBox="0 0 120 180" fill="none" aria-hidden="true"><path d="M59 174V89c-1-18 9-19 3-38M59 153c-28-3-39-18-39-30 24-2 37 11 39 30Zm0-21c30-5 44-22 42-37-28 0-41 17-42 37Z"/><path d="M61 66C34 87 26 65 43 51c-28-7-19-31 5-22C44 2 70 1 73 27c22-14 39 9 15 23 26 14 11 37-13 23-4 27-31 22-27-1"/><circle cx="62" cy="49" r="9"/></svg>
  </section>
</main>
{% include '@trotamundos/components/footer.html.twig' %}
