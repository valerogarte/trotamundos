<!DOCTYPE html>
<html{{ html_attributes }}>
  <head>
    <head-placeholder token="{{ placeholder_token }}">
    <title>{{ head_title|safe_join(' | ') }}</title>
    {% if is_front %}
      <meta name="theme-color" content="#173D32">
      <meta name="description" content="{{ meta_description }}">
      <link rel="preload" as="image" href="{{ trotamundos_path }}/assets/video/hero-naturaleza-poster.webp?v=2" media="(min-width: 640px) and (orientation: landscape)" fetchpriority="high">
      <link rel="preload" as="image" href="{{ trotamundos_path }}/assets/video/hero-naturaleza-mobile-poster.webp?v=2" media="(max-width: 639px), (orientation: portrait)" fetchpriority="high">
    {% else %}
      <meta name="theme-color" content="#F5F0E6">
    {% endif %}
    <link rel="preload" as="font" href="{{ trotamundos_path }}/assets/fonts/cormorant-garamond-latin.woff2" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="{{ trotamundos_path }}/assets/fonts/manrope-latin.woff2" type="font/woff2" crossorigin>
    <css-placeholder token="{{ placeholder_token }}">
    <js-placeholder token="{{ placeholder_token }}">
  </head>
  <body{{ attributes }}>
    <a class="skip-link" href="#main-content">{{ 'Saltar al contenido'|t }}</a>
    {{ page_top }}
    {{ page }}
    {{ page_bottom }}
    <js-bottom-placeholder token="{{ placeholder_token }}">
  </body>
</html>
