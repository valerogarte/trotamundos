<?php

/**
 * @file
 * Presentation data and preprocess hooks for the Trotamundos theme.
 */

use Drupal\Core\Language\LanguageInterface;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;
use Drupal\trotamundos_assistant\Plugin\Block\TrotamundosAssistantBlock;
use Drupal\trotamundos_experiences\Setup\ProductTypes;

/**
 * Routes that use the full-width page shell.
 */
const TROTAMUNDOS_FULL_ROUTES = [
  'trotamundos_experiences.catalog',
  'trotamundos_experiences.stays',
  'trotamundos_experiences.experiences',
  'trotamundos_experiences.packages',
  'trotamundos_destinations.list',
  'trotamundos_pages.esencia',
  'trotamundos_pages.ayuda',
];

/**
 * Implements hook_preprocess_html().
 */
function trotamundos_preprocess_html(array &$variables): void {
  $variables['trotamundos_path'] = _trotamundos_path();
  $variables['attributes']['class'][] = 'trotamundos-page';
  $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();
  if ($variables['is_front']) {
    $variables['head_title']['title'] = t('Experiencias en destinos poco conocidos de Colombia');
  }
  $variables['meta_description'] = t('Descubre destinos poco conocidos de Colombia y reserva experiencias con anfitriones locales. Viajar bonito. Sentir de verdad.');
}

/**
 * Implements hook_preprocess_page().
 */
function trotamundos_preprocess_page(array &$variables): void {
  $variables['trotamundos_path'] = _trotamundos_path();
  $variables['tm'] = _trotamundos_site_data();
  $variables['trotamundos_brand_guide_url'] = \Drupal::moduleHandler()->moduleExists('trotamundos_brand')
    ? Url::fromRoute('trotamundos_brand.guide')->toString()
    : NULL;
  if (\Drupal::moduleHandler()->moduleExists('trotamundos_assistant')) {
    $variables['tm_assistant'] = [
      '#lazy_builder' => [TrotamundosAssistantBlock::class . '::buildSearch', []],
      '#create_placeholder' => TRUE,
    ];
  }
  $variables['tm_cache'] = _trotamundos_cache(['config:trotamundos.settings', 'config:user.settings'], ['url.path', 'url.query_args', 'languages:language_interface', 'user.roles:authenticated']);

  if (\Drupal::hasService('trotamundos_experiences.repository')) {
    $repository = \Drupal::service('trotamundos_experiences.repository');
    $filters = \Drupal::request()->attributes->get('_trotamundos_catalog_filters', []);
    $variables['tm_catalog_controls'] = \Drupal::request()->attributes->get('_trotamundos_catalog_controls');
    $variables['tm_search_filters'] = $filters;
    $variables['tm_discovery'] = $repository->filterOptions($filters);
    $variables['tm_date_label'] = $repository->dateLabel($filters);
    $variables['tm_cache'] = _trotamundos_cache(
      array_merge(['config:trotamundos.settings', 'config:user.settings'], ProductTypes::CACHE_TAGS),
      ['url.path', 'url.query_args', 'languages:language_interface', 'languages:language_content', 'user.roles:authenticated', 'user.permissions', 'user.node_grants:view'],
      strtotime('tomorrow', \Drupal::time()->getRequestTime()) - \Drupal::time()->getRequestTime(),
    );
  }
  if (!empty($variables['is_front']) && \Drupal::hasService('trotamundos_experiences.repository')) {
    $cards = $repository->featured(8);
    $destinations = array_values($repository->destinationIndex());
    usort($destinations, static fn (array $a, array $b): int => [$b['count'], $a['title']] <=> [$a['count'], $b['title']]);
    $variables['tm_featured'] = $cards;
    $variables['tm_styles'] = $variables['tm_discovery']['styles'];
    $variables['tm_destinations'] = array_slice($destinations, 0, 5);
  }
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function trotamundos_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  $route_match = \Drupal::routeMatch();
  $route = $route_match->getRouteName();
  if ($route === 'trotamundos_brand.guide') {
    $suggestions[] = 'page__brand_guide';
  }
  elseif (in_array($route, TROTAMUNDOS_FULL_ROUTES, TRUE)) {
    $suggestions[] = 'page__full';
  }
  elseif ($route === 'entity.node.canonical') {
    $node = $route_match->getParameter('node');
    if ($node instanceof NodeInterface && in_array($node->bundle(), [...ProductTypes::BUNDLES, 'destino'], TRUE)) {
      $suggestions[] = 'page__full';
    }
  }
}

/**
 * Implements hook_preprocess_node().
 */
function trotamundos_preprocess_node(array &$variables): void {
  $node = $variables['node'];
  if ($variables['view_mode'] !== 'full' || !\Drupal::hasService('trotamundos_experiences.repository')) {
    return;
  }
  $repository = \Drupal::service('trotamundos_experiences.repository');
  $variables['trotamundos_path'] = _trotamundos_path();
  $variables['tm'] = _trotamundos_site_data();

  if (in_array($node->bundle(), ProductTypes::BUNDLES, TRUE)) {
    $experience = $repository->detail($node);
    $variables['experience'] = $experience;
    $variables['related'] = $repository->related($node, 3);
    $variables['experience_whatsapp_url'] = _trotamundos_whatsapp_url($experience['whatsapp_text']);
    $variables['map'] = _trotamundos_map_point($experience['destination']);
    $variables['tm_cache'] = _trotamundos_cache(
      array_merge(['config:trotamundos.settings'], ProductTypes::CACHE_TAGS),
      ['languages:language_interface', 'languages:language_content'],
      // Availability periods that already ended disappear at midnight.
      strtotime('tomorrow') - \Drupal::time()->getRequestTime(),
    );
  }
  elseif ($node->bundle() === 'destino') {
    $index = $repository->destinationIndex();
    $destination = $index[(int) $node->id()] ?? NULL;
    $variables['destination'] = $destination;
    $variables['destination_experiences'] = $repository->forDestination((int) $node->id());
    $variables['map'] = _trotamundos_map_point($destination);
    $variables['destination_catalog_url'] = $destination
      ? Url::fromRoute('trotamundos_experiences.catalog', [], ['query' => ['destino' => $destination['department_slug'] . '/' . $destination['municipality_slug']]])->toString()
      : NULL;
    $variables['destination_whatsapp_url'] = _trotamundos_whatsapp_url((string) t('Hola, me interesa viajar a @place. ¿Qué experiencias tienen?', ['@place' => $destination['title'] ?? $node->label()]));
    $variables['tm_cache'] = _trotamundos_cache(array_merge(['config:trotamundos.settings'], ProductTypes::CACHE_TAGS), ['languages:language_interface', 'languages:language_content']);
  }
}

/**
 * Prepares the brand guide with the same components used on the website.
 */
function trotamundos_preprocess_trotamundos_brand_guide(array &$variables): void {
  $variables['trotamundos_path'] = _trotamundos_path();
  $variables['brand_experiences'] = \Drupal::hasService('trotamundos_experiences.repository')
    ? \Drupal::service('trotamundos_experiences.repository')->featured(3)
    : [];
  $variables['tm'] = _trotamundos_site_data();
}

/**
 * Shared data for the catalog, destination and editorial page templates.
 */
function trotamundos_preprocess_trotamundos_catalog(array &$variables): void {
  $variables['trotamundos_path'] = _trotamundos_path();
  $variables['tm'] = _trotamundos_site_data();
}

/**
 * Implements hook_preprocess_HOOK() for the destinations page.
 */
function trotamundos_preprocess_trotamundos_destinations(array &$variables): void {
  $variables['trotamundos_path'] = _trotamundos_path();
  $variables['tm'] = _trotamundos_site_data();
  $variables['atlas'] = _trotamundos_destination_atlas($variables['tree']);
}

/**
 * Implements hook_preprocess_HOOK() for the essence page.
 */
function trotamundos_preprocess_trotamundos_esencia(array &$variables): void {
  $variables['trotamundos_path'] = _trotamundos_path();
  $variables['tm'] = _trotamundos_site_data();
}

/**
 * Implements hook_preprocess_HOOK() for the help page.
 */
function trotamundos_preprocess_trotamundos_ayuda(array &$variables): void {
  $variables['trotamundos_path'] = _trotamundos_path();
  $variables['tm'] = _trotamundos_site_data();
}

/**
 * Supplies the site privacy link to the assistant embedded in the search.
 */
function trotamundos_preprocess_trotamundos_assistant(array &$variables): void {
  if (!empty($variables['elements']['#search_inline'])) {
    $variables['privacy_url'] = _trotamundos_site_data()['privacy_url'];
  }
}

/**
 * Base path of the theme, for static assets.
 */
function _trotamundos_path(): string {
  return base_path() . \Drupal::service('extension.list.theme')->getPath('trotamundos');
}

/**
 * Navigation, languages and contact channels shared by every page.
 */
function _trotamundos_site_data(): array {
  $data = &drupal_static(__FUNCTION__);
  if ($data !== NULL) {
    return $data;
  }

  $route_match = \Drupal::routeMatch();
  $route = (string) $route_match->getRouteName();
  $node = $route_match->getParameter('node');
  $bundle = $node instanceof NodeInterface ? $node->bundle() : NULL;
  $route_provider = \Drupal::service('router.route_provider');
  $exists = static function (string $name) use ($route_provider): bool {
    return count($route_provider->getRoutesByNames([$name])) === 1;
  };

  $items = [
    ['route' => 'trotamundos_experiences.stays', 'label' => t('Alojamientos'), 'icon' => 'bed', 'bundle' => 'alojamiento'],
    ['route' => 'trotamundos_experiences.experiences', 'label' => t('Experiencias'), 'icon' => 'compass', 'bundle' => 'experiencia'],
    ['route' => 'trotamundos_experiences.packages', 'label' => t('Paquetes'), 'icon' => 'suitcase', 'bundle' => 'paquete'],
    ['route' => 'trotamundos_destinations.list', 'label' => t('Destinos'), 'icon' => 'pin', 'bundle' => 'destino'],
    ['route' => 'trotamundos_pages.esencia', 'label' => t('Nuestra esencia'), 'icon' => 'heart', 'bundle' => NULL],
    ['route' => 'trotamundos_pages.ayuda', 'label' => t('Ayuda'), 'icon' => 'help', 'bundle' => NULL],
  ];
  $navigation = [];
  foreach ($items as $item) {
    if (!$exists($item['route'])) {
      continue;
    }
    $navigation[] = [
      'label' => $item['label'],
      'icon' => $item['icon'],
      'secondary' => !in_array($item['bundle'], ProductTypes::BUNDLES, TRUE),
      'url' => Url::fromRoute($item['route'])->toString(),
      'current' => $route === $item['route'],
      'active' => $route === $item['route'] || ($item['bundle'] && $bundle === $item['bundle']),
    ];
  }

  $explore_items = [
    ['route' => 'trotamundos_experiences.stays', 'label' => t('Alojamientos'), 'icon' => 'bed', 'active' => $route === 'trotamundos_experiences.stays' || $bundle === 'alojamiento'],
    ['route' => 'trotamundos_experiences.experiences', 'label' => t('Experiencias'), 'icon' => 'compass', 'active' => $route === 'trotamundos_experiences.experiences' || $bundle === 'experiencia'],
    ['route' => 'trotamundos_experiences.packages', 'label' => t('Paquetes'), 'icon' => 'suitcase', 'active' => $route === 'trotamundos_experiences.packages' || $bundle === 'paquete'],
  ];
  $search_filters = \Drupal::request()->attributes->get('_trotamundos_catalog_filters', []);
  $search_query = array_intersect_key($search_filters, array_flip(['destino', 'fecha', 'desde', 'hasta', 'margen', 'acompanamiento']));
  $search_query = array_filter($search_query, static fn ($value): bool => $value !== '');
  $explore_navigation = [];
  foreach ($explore_items as $item) {
    if ($item['route'] !== '<front>' && !$exists($item['route'])) {
      continue;
    }
    $explore_navigation[] = [
      'label' => $item['label'],
      'icon' => $item['icon'],
      'url' => Url::fromRoute($item['route'], [], ['query' => $search_query])->toString(),
      'active' => $item['active'],
      'current' => $route === $item['route'],
    ];
  }

  $settings = \Drupal::config('trotamundos.settings');
  $number = preg_replace('/\D+/', '', (string) ($settings->get('whatsapp_number') ?: '573114232421'));
  $instagram = ltrim((string) ($settings->get('instagram') ?: 'juantrotamundos'), '@');

  $data = [
    'navigation' => $navigation,
    'explore_navigation' => $explore_navigation,
    'languages' => _trotamundos_language_links(),
    'langcode' => \Drupal::languageManager()->getCurrentLanguage()->getId(),
    'whatsapp_number' => $number,
    'whatsapp_display' => _trotamundos_format_phone($number),
    'whatsapp_base' => 'https://wa.me/' . $number,
    'whatsapp_url' => _trotamundos_whatsapp_url((string) t('Hola, Trotamundos. Me gustaría recibir información sobre sus experiencias.')),
    'email' => (string) ($settings->get('contact_email') ?: 'juantrotamundoscol@gmail.com'),
    'instagram' => $instagram,
    'instagram_url' => 'https://www.instagram.com/' . $instagram . '/',
    'catalog_url' => $exists('trotamundos_experiences.catalog') ? Url::fromRoute('trotamundos_experiences.catalog')->toString() : '#',
    'cart_available' => $exists('commerce_cart.page'),
    'discovery_url' => isset(ProductTypes::ROUTES[$bundle ?? ''])
      ? Url::fromRoute(ProductTypes::ROUTES[$bundle])->toString()
      : Url::fromRoute(in_array($route, ProductTypes::ROUTES, TRUE) ? $route : 'trotamundos_experiences.catalog')->toString(),
    'destinations_url' => $exists('trotamundos_destinations.list') ? Url::fromRoute('trotamundos_destinations.list')->toString() : '#',
    'esencia_url' => $exists('trotamundos_pages.esencia') ? Url::fromRoute('trotamundos_pages.esencia')->toString() : '#',
    'ayuda_url' => $exists('trotamundos_pages.ayuda') ? Url::fromRoute('trotamundos_pages.ayuda')->toString() : '#',
    'account_label' => \Drupal::currentUser()->isAuthenticated() ? t('Mi cuenta') : t('Iniciar sesión'),
    'registration_available' => \Drupal::config('user.settings')->get('register') !== 'admin_only' && \Drupal::currentUser()->isAnonymous(),
  ];
  return $data;
}

/**
 * WhatsApp link with a prefilled message.
 */
function _trotamundos_whatsapp_url(string $message): string {
  $number = preg_replace('/\D+/', '', (string) (\Drupal::config('trotamundos.settings')->get('whatsapp_number') ?: '573114232421'));
  return 'https://wa.me/' . $number . '?text=' . rawurlencode($message);
}

/**
 * Formats a Colombian mobile number for display: +57 311 423 2421.
 */
function _trotamundos_format_phone(string $number): string {
  if (preg_match('/^57(\d{3})(\d{3})(\d{4})$/', $number, $parts)) {
    return '+57 ' . $parts[1] . ' ' . $parts[2] . ' ' . $parts[3];
  }
  return '+' . $number;
}

/**
 * Links to the current page in each enabled language.
 */
function _trotamundos_language_links(): array {
  $language_manager = \Drupal::languageManager();
  if (!$language_manager->isMultilingual()) {
    return [];
  }
  $current = $language_manager->getCurrentLanguage()->getId();
  try {
    $url = \Drupal::service('path.matcher')->isFrontPage()
      ? Url::fromRoute('<front>')
      : Url::fromRouteMatch(\Drupal::routeMatch());
    $query = \Drupal::request()->query->all();
    unset($query['page']);
    if ($query) {
      $url->setOption('query', $query);
    }
  }
  catch (\Throwable $exception) {
    $url = Url::fromRoute('<front>');
  }

  $switch = $language_manager->getLanguageSwitchLinks(LanguageInterface::TYPE_INTERFACE, $url);
  $links = [];
  foreach ($switch->links ?? [] as $langcode => $link) {
    $names = ['es' => 'Español', 'en' => 'English'];
    $links[] = [
      'code' => $langcode,
      'name' => $names[$langcode] ?? $link['title'],
      'url' => $link['url'] instanceof Url ? $link['url']->setOption('language', $link['language'] ?? NULL)->toString() : '#',
      'current' => $langcode === $current,
    ];
  }
  return $links;
}

/**
 * Projects a destination onto the Colombia outline (see assets/maps).
 */
function _trotamundos_map_point(?array $destination): ?array {
  if (!$destination || $destination['latitude'] === NULL || $destination['longitude'] === NULL || $destination['latitude'] === '' || $destination['longitude'] === '') {
    return NULL;
  }
  $scale = 37.191863164176944;
  $x = 74.07032849353203 + ((float) $destination['longitude'] + 79.025439) * $scale;
  $y = 20.0 + (12.434375 - (float) $destination['latitude']) * $scale;
  return [
    'x' => round($x / 600 * 100, 2),
    'y' => round($y / 660 * 100, 2),
    'label' => $destination['place'],
  ];
}

/**
 * Lays out destination links around their approximate geographic positions.
 */
function _trotamundos_destination_atlas(array $tree): array {
  $places = [];
  $bounds = ['left' => 0.0, 'top' => 0.0, 'right' => 600.0, 'bottom' => 660.0];
  $mapped = 0;
  foreach ($tree as $region) {
    foreach ($region['departments'] as $department) {
      foreach ($department['destinations'] as $destination) {
        $destination['number'] = count($places) + 1;
        $destination['map'] = NULL;
        $latitude = $destination['latitude'] ?? NULL;
        $longitude = $destination['longitude'] ?? NULL;
        // Include Colombia's offshore islands, but not invalid coordinates.
        if (is_numeric($latitude) && is_numeric($longitude)
          && (float) $latitude >= -5 && (float) $latitude <= 16
          && (float) $longitude >= -83 && (float) $longitude <= -66) {
          $point = _trotamundos_map_point($destination);
          $x = $point['x'] * 6;
          $y = $point['y'] * 6.6;
          $destination['map'] = ['raw_x' => $x, 'raw_y' => $y];
          $bounds['left'] = min($bounds['left'], $x - 48);
          $bounds['right'] = max($bounds['right'], $x + 48);
          $bounds['top'] = min($bounds['top'], $y - 48);
          $bounds['bottom'] = max($bounds['bottom'], $y + 48);
          $mapped++;
        }
        $places[] = $destination;
      }
    }
  }

  $width = $bounds['right'] - $bounds['left'];
  $height = $bounds['bottom'] - $bounds['top'];
  $margin = 42.0;
  $available_width = $width - 2 * $margin;
  $available_height = $height - 2 * $margin;
  // Separate nearby labels; their leader lines still point to the real places.
  $columns = max(2, (int) floor($available_width / 78) + 1);
  $rows = max(2, (int) floor($available_height / 78) + 1);
  while ($columns * $rows < $mapped) {
    if ($available_width / $columns >= $available_height / $rows) {
      $columns++;
    }
    else {
      $rows++;
    }
  }
  $slots = [];
  for ($row = 0; $row < $rows; $row++) {
    for ($column = 0; $column < $columns; $column++) {
      $slots[] = [
        'x' => $bounds['left'] + $margin + $column * $available_width / ($columns - 1),
        'y' => $bounds['top'] + $margin + $row * $available_height / ($rows - 1),
      ];
    }
  }

  foreach ($places as &$place) {
    if ($place['map'] === NULL) {
      continue;
    }
    $x = $place['map']['raw_x'];
    $y = $place['map']['raw_y'];
    $nearest = NULL;
    $distance = INF;
    foreach ($slots as $index => $slot) {
      $candidate_distance = ($slot['x'] - $x) ** 2 + ($slot['y'] - $y) ** 2;
      if ($candidate_distance < $distance) {
        $nearest = $index;
        $distance = $candidate_distance;
      }
    }
    $slot = $slots[$nearest];
    unset($slots[$nearest]);
    $place['map'] = [
      'x' => round(($x - $bounds['left']) / $width * 100, 3),
      'y' => round(($y - $bounds['top']) / $height * 100, 3),
      'label_x' => round(($slot['x'] - $bounds['left']) / $width * 100, 3),
      'label_y' => round(($slot['y'] - $bounds['top']) / $height * 100, 3),
    ];
  }
  unset($place);

  return [
    'places' => $places,
    'mapped' => $mapped,
    'width' => round($width, 3),
    'height' => round($height, 3),
    'outline_left' => round(-$bounds['left'] / $width * 100, 3),
    'outline_top' => round(-$bounds['top'] / $height * 100, 3),
    'outline_width' => round(600 / $width * 100, 3),
  ];
}

/**
 * An empty render element that only carries cache metadata.
 */
function _trotamundos_cache(array $tags, array $contexts, ?int $max_age = NULL): array {
  $cache = ['tags' => $tags, 'contexts' => $contexts];
  if ($max_age !== NULL) {
    $cache['max-age'] = max(1, $max_age);
  }
  return ['#markup' => '', '#cache' => $cache];
}
