{% import '@trotamundos_3/components/icons.html.twig' as icons %}
<article class="tm3-place" data-tm3-card data-category="{{ experience.category }}">
  <button class="tm3-place__photo" type="button" data-tm3-dialog-open="tm3-place-{{ experience.id }}" aria-label="{{ 'Descubrir @name'|t({'@name': experience.name}) }}"><img src="{{ tm3_path }}/assets/images/{{ experience.image }}" alt="{{ experience.alt }}" width="1100" height="825" loading="lazy" decoding="async"><span class="tm3-place__tag">{{ experience.label }}</span></button>
  <div class="tm3-place__copy"><p class="tm3-place__location">{{ icons.icon('pin') }} {{ experience.region }}</p><h3><button type="button" data-tm3-dialog-open="tm3-place-{{ experience.id }}">{{ experience.name }}</button></h3><p class="tm3-place__description">{{ experience.title }}</p><button class="tm3-place__link" type="button" data-tm3-dialog-open="tm3-place-{{ experience.id }}">{{ 'Conocer este lugar'|t }} <span aria-hidden="true">{{ icons.icon('diagonal') }}</span></button></div>
</article>
