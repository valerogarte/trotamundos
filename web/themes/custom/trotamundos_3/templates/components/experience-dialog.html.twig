{% import '@trotamundos_3/components/icons.html.twig' as icons %}
<dialog class="tm3-dialog" id="tm3-place-{{ experience.id }}" data-tm3-dialog aria-labelledby="tm3-dialog-title-{{ experience.id }}"><button class="tm3-dialog__close" type="button" data-tm3-dialog-close aria-label="{{ 'Cerrar detalle'|t }}">{{ icons.icon('close') }}</button><div class="tm3-dialog__layout"><img class="tm3-dialog__photo" src="{{ tm3_path }}/assets/images/{{ experience.image }}" alt="{{ experience.alt }}" width="1100" height="825" loading="lazy" decoding="async"><div class="tm3-dialog__copy"><p class="tm3-eyebrow">{{ experience.label }} · {{ experience.region }}</p><h2 id="tm3-dialog-title-{{ experience.id }}">{{ experience.name }}</h2><p class="tm3-dialog__intro">{{ experience.title }}</p><p>{{ experience.description }}</p><ul>{% for moment in experience.moments %}<li>{{ icons.icon('check') }} {{ moment }}</li>{% endfor %}</ul><div class="tm3-dialog__notice"><strong>{{ 'Un lugar para empezar a imaginar.'|t }}</strong><p>{{ 'Esta es una inspiración de viaje. Estamos preparando las primeras experiencias; las opciones, fechas y disponibilidad se anunciarán cuando estén confirmadas.'|t }}</p></div><button class="tm3-button tm3-button--dark" type="button" data-tm3-dialog-close>{{ 'Seguir descubriendo'|t }} {{ icons.icon('arrow') }}</button></div></div></dialog>
