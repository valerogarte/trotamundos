{% import '@trotamundos_3/components/icons.html.twig' as icons %}
{% include '@trotamundos_3/components/header.html.twig' %}
<main id="main-content" tabindex="-1">
  <section class="tm3-hero" aria-labelledby="tm3-hero-title">
    <div class="tm3-container tm3-hero__intro"><p class="tm3-eyebrow tm3-hero__eyebrow"><span aria-hidden="true"></span>{{ 'COLOMBIA, CON LOS CINCO SENTIDOS'|t }}</p><h1 id="tm3-hero-title">{{ 'Una Colombia'|t }}<br><em>{{ 'que se siente.'|t }}</em></h1><p class="tm3-hero__description">{{ 'Un pueblo que te sorprende. Un paisaje que te abraza.'|t }}<br>{{ 'Ese lugar al que todavía no sabes que quieres volver.'|t }}</p><a class="tm3-button tm3-button--primary" href="#experiencias">{{ 'Encuentra tu lugar'|t }} {{ icons.icon('diagonal') }}</a><p class="tm3-hero__signature">{{ 'Con la mirada de Juan Trota Mundos'|t }}</p></div>
    <div class="tm3-container tm3-hero__landscapes" aria-label="{{ 'Tres maneras de sentir Colombia'|t }}">
      <figure class="tm3-landscape tm3-landscape--village"><img src="{{ tm3_path }}/assets/images/pueblo.webp" alt="{{ 'Casas tradicionales y balcones de colores en Concepción, Antioquia.'|t }}" width="1100" height="825" decoding="async"><figcaption>{{ icons.icon('pin') }} {{ 'La vida de pueblo'|t }}<span>{{ 'Concepción, Antioquia'|t }}</span></figcaption></figure>
      <figure class="tm3-landscape tm3-landscape--caribe"><picture><source media="(max-width: 639px)" srcset="{{ tm3_path }}/assets/images/hero-caribe-mobile.webp" width="1080" height="1920"><img src="{{ tm3_path }}/assets/images/hero-caribe.webp" alt="{{ 'El mar turquesa y la costa verde de las Islas del Rosario, Colombia, vistos desde el aire.'|t }}" width="2560" height="1707" fetchpriority="high" decoding="async"></picture><figcaption>{{ icons.icon('pin') }} {{ 'El Caribe, sin mirar el reloj'|t }}<span>{{ 'Islas del Rosario, Colombia'|t }}</span></figcaption></figure>
      <figure class="tm3-landscape tm3-landscape--water"><img src="{{ tm3_path }}/assets/images/termales.webp" alt="{{ 'Agua y vegetación en los termales de Santa Rosa de Cabal. Imagen de inspiración.'|t }}" width="1100" height="733" decoding="async"><figcaption>{{ icons.icon('pin') }} {{ 'Una pausa entre montañas'|t }}<span>{{ 'Naturaleza que acompaña'|t }}</span></figcaption></figure>
    </div>
    <a class="tm3-scroll-hint" href="#experiencias"><span>{{ 'Un poquito más allá'|t }}</span>{{ icons.icon('down') }}</a>
  </section>

  {% if page.highlighted %}<div class="tm3-container tm3-messages">{{ page.highlighted }}</div>{% endif %}

  <section class="tm3-experiences tm3-container" id="experiencias" aria-labelledby="tm3-experiences-title" data-tm3-experiences><div class="tm3-section-heading"><p class="tm3-eyebrow">{{ 'LUGARES QUE INVITAN A QUEDARSE'|t }}</p><h2 id="tm3-experiences-title">{{ 'La pausa que buscas'|t }}<br><em>{{ 'está por aquí.'|t }}</em></h2><p>{{ 'Sigue lo que te apetece. Lo demás empieza en el camino.'|t }}</p></div><div class="tm3-experience-tools"><div class="tm3-filters" role="group" aria-label="{{ 'Elegir qué lugares descubrir'|t }}"><button type="button" data-tm3-filter="all" aria-pressed="true">{{ 'Todos los lugares'|t }}</button><button type="button" data-tm3-filter="pueblos" aria-pressed="false">{{ icons.icon('village') }} {{ 'Pueblos'|t }}</button><button type="button" data-tm3-filter="bienestar" aria-pressed="false">{{ icons.icon('water') }} {{ 'Bienestar'|t }}</button><button type="button" data-tm3-filter="naturaleza" aria-pressed="false">{{ icons.icon('leaf') }} {{ 'Naturaleza'|t }}</button></div><span data-tm3-results>{{ '3 lugares'|t }}</span></div><p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-tm3-status></p><div class="tm3-place-grid" id="destinos">{% for experience in tm3_experiences %}{% include '@trotamundos_3/components/experience-card.html.twig' with {experience: experience} %}{% endfor %}</div><p class="tm3-experiences__note">{{ 'Una selección para inspirarte. Estamos preparando nuestras primeras experiencias y su disponibilidad.'|t }}</p></section>

  <section class="tm3-philosophy" id="esencia" aria-labelledby="tm3-philosophy-title"><div class="tm3-container"><p class="tm3-eyebrow">{{ 'NUESTRA MANERA DE MIRAR'|t }}</p><svg class="tm3-philosophy__path" viewBox="0 0 144 50" fill="none" aria-hidden="true"><path d="M5 38c27 0 17-27 41-27s18 29 40 29 19-29 53-29" stroke="currentColor" stroke-width="1.5"/><circle cx="5" cy="38" r="4" fill="currentColor"/><circle cx="139" cy="11" r="4" fill="currentColor"/></svg><h2 id="tm3-philosophy-title">{{ 'Para viajar bonito,'|t }}<br><em>{{ 'mira un poco más cerca.'|t }}</em></h2><p class="tm3-philosophy__intro">{{ 'Nos inspira esa Colombia que se descubre al conversar, al aceptar un desvío, al quedarse un ratito más. La mirada de Juan Trota Mundos es el punto de partida. Tu curiosidad hace el resto.'|t }}</p><div class="tm3-values"><article><span>{{ icons.icon('village') }}</span><h3>{{ 'Lugares con alma'|t }}</h3><p>{{ 'Pueblos y rincones que conservan su forma de vivir y una historia que merece ser escuchada.'|t }}</p></article><article><span>{{ icons.icon('leaf') }}</span><h3>{{ 'Espacio para respirar'|t }}</h3><p>{{ 'Paisajes abiertos y pequeñas pausas para disfrutar de lo que tienes delante.'|t }}</p></article><article><span>{{ icons.icon('route') }}</span><h3>{{ 'Ganas de descubrir'|t }}</h3><p>{{ 'Una invitación a seguir el camino con los ojos abiertos y sin tantas prisas.'|t }}</p></article></div></div></section>

  <section class="tm3-journal tm3-container" aria-labelledby="tm3-journal-title"><div class="tm3-journal__photo"><img src="{{ tm3_path }}/assets/images/concepcion.webp" alt="{{ 'Una calle de piedra de Concepción, entre fachadas blancas y detalles de colores.'|t }}" width="1100" height="825" loading="lazy" decoding="async"><div class="tm3-journal__caption"><span class="tm3-eyebrow">{{ 'DEL CUADERNO DE VIAJE'|t }}</span><h2 id="tm3-journal-title">{{ 'Hay sitios que'|t }}<br><em>{{ 'te cambian el paso.'|t }}</em></h2><button class="tm3-button tm3-button--primary" type="button" data-tm3-dialog-open="tm3-place-concepcion">{{ 'Un paseo por Concepción'|t }} {{ icons.icon('diagonal') }}</button></div><span class="tm3-journal__location">{{ icons.icon('pin') }} {{ 'Concepción · Antioquia'|t }}</span></div><div class="tm3-journal__note"><span>{{ 'A veces, la mejor parte del viaje'|t }}<br>{{ 'es lo que no habías planeado.'|t }}</span><span>CO / {{ 'PEQUEÑOS GRANDES ENCUENTROS'|t }}</span></div></section>

  <section class="tm3-faq tm3-container" id="preguntas" aria-labelledby="tm3-faq-title"><div class="tm3-section-heading"><p class="tm3-eyebrow">{{ 'ANTES DE HACER LA MALETA'|t }}</p><h2 id="tm3-faq-title">{{ 'Unas cosas'|t }}<br><em>{{ 'antes de salir.'|t }}</em></h2></div><div class="tm3-faq__list"><details><summary>{{ '¿Qué viajes estamos preparando?'|t }}<span>{{ icons.icon('plus') }}</span></summary><p>{{ 'Las primeras experiencias se están preparando en Concepción y en los termales, con opciones de alojamiento y de paquete. Compartiremos los detalles cuando estén confirmados.'|t }}</p></details><details><summary>{{ '¿Puedo reservar estos lugares ya?'|t }}<span>{{ icons.icon('plus') }}</span></summary><p>{{ 'Por ahora puedes conocer los lugares que nos inspiran. Estamos preparando las primeras propuestas; los precios, las fechas y la disponibilidad se anunciarán más adelante.'|t }}</p></details><details><summary>{{ '¿Quién está detrás de Trotamundos?'|t }}<span>{{ icons.icon('plus') }}</span></summary><p>{{ 'Juan Trota Mundos y su forma de descubrir Colombia: con curiosidad por los pueblos, los paisajes y las personas que hacen especial cada lugar.'|t }}</p></details></div></section>

  <section class="tm3-closing tm3-container" aria-labelledby="tm3-closing-title"><span class="tm3-closing__line" aria-hidden="true"></span><p class="tm3-eyebrow">{{ 'EL CAMINO EMPIEZA CUANDO TE APETECE'|t }}</p><h2 id="tm3-closing-title">{{ 'Tu próxima pausa'|t }}<br><em>{{ 'puede empezar aquí.'|t }}</em></h2><a class="tm3-button tm3-button--gold" href="#experiencias">{{ 'Vamos a descubrirla'|t }} {{ icons.icon('diagonal') }}</a></section>

  <div class="tm3-container tm3-front-content">{{ page.content|without('trotamundos_3_content', 'system_main') }}</div>
  {% for experience in tm3_experiences %}{% include '@trotamundos_3/components/experience-dialog.html.twig' with {experience: experience} %}{% endfor %}
</main>
{% include '@trotamundos_3/components/footer.html.twig' %}
