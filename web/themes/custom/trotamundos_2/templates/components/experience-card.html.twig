{% import '@trotamundos_2/components/icons.html.twig' as icons %}
<article class="tm2-trip-card tm2-trip-card--{{ experience.id }}" data-tm2-card data-category="{{ experience.category }}">
  <button class="tm2-trip-card__image" type="button" data-tm2-dialog-open="tm2-trip-{{ experience.id }}" aria-label="{{ 'Descubrir @name'|t({'@name': experience.name}) }}">
    <img src="{{ tm2_path }}/assets/images/{{ experience.image }}" alt="{{ experience.alt }}" width="1100" height="825" loading="lazy" decoding="async">
    <span class="tm2-trip-card__label">{{ experience.label }}</span>
    <span class="tm2-trip-card__arrow" aria-hidden="true">{{ icons.icon('diagonal') }}</span>
  </button>
  <div class="tm2-trip-card__copy">
    <p class="tm2-trip-card__meta"><span>{{ experience.region }}</span><span>CO / {{ experience.number }}</span></p>
    <h3><button type="button" data-tm2-dialog-open="tm2-trip-{{ experience.id }}">{{ experience.name }}</button></h3>
    <p class="tm2-trip-card__tagline">{{ experience.title }}</p>
    {% if experience.id == 'cocora' %}<p class="tm2-trip-card__description">{{ 'Hay caminos que te llevan a un lugar. Y otros que te devuelven a ti. El verde del Quindío tiene un poco de los dos.'|t }}</p>{% endif %}
    <button class="tm2-text-link" type="button" data-tm2-dialog-open="tm2-trip-{{ experience.id }}">{{ 'Descubre este lugar'|t }} {{ icons.icon('arrow') }}</button>
  </div>
</article>
