{% import '@trotamundos_4/components/icons.html.twig' as icons %}
<article class="tm4-entry" data-tm4-card data-category="{{ experience.category }}"><button class="tm4-entry__photo" type="button" data-tm4-dialog-open="tm4-place-{{ experience.id }}" aria-label="{{ 'Descubrir @name'|t({'@name': experience.name}) }}"><img src="{{ tm4_path }}/assets/images/{{ experience.image }}" alt="{{ experience.alt }}" width="1100" height="825" loading="lazy" decoding="async"></button><div class="tm4-entry__copy"><p class="tm4-entry__meta">{{ experience.label }}<span>{{ experience.region }}</span></p><h3><button type="button" data-tm4-dialog-open="tm4-place-{{ experience.id }}">{{ experience.name }}</button></h3><p>{{ experience.title }}</p><button class="tm4-text-link" type="button" data-tm4-dialog-open="tm4-place-{{ experience.id }}">{{ 'Abre esta historia'|t }} {{ icons.icon('arrow') }}</button></div><span class="tm4-entry__number" aria-hidden="true">{{ experience.number }}</span></article>
