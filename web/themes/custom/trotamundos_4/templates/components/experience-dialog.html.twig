{% import '@trotamundos_4/components/icons.html.twig' as icons %}
<dialog class="tm4-dialog" id="tm4-place-{{ experience.id }}" data-tm4-dialog aria-labelledby="tm4-dialog-title-{{ experience.id }}"><button class="tm4-dialog__close" type="button" data-tm4-dialog-close aria-label="{{ 'Cerrar detalle'|t }}">{{ icons.icon('close') }}</button><div class="tm4-dialog__layout"><img class="tm4-dialog__photo" src="{{ tm4_path }}/assets/images/{{ experience.image }}" alt="{{ experience.alt }}" width="1100" height="825" loading="lazy" decoding="async"><div class="tm4-dialog__copy"><p class="tm4-eyebrow">{{ experience.label }} / {{ experience.region }}</p><h2 id="tm4-dialog-title-{{ experience.id }}">{{ experience.name }}</h2><p class="tm4-dialog__intro">{{ experience.title }}</p><p>{{ experience.description }}</p><ul>{% for moment in experience.moments %}<li>{{ icons.icon('check') }} {{ moment }}</li>{% endfor %}</ul><div class="tm4-dialog__notice"><strong>{{ 'Una ficha para empezar a imaginar.'|t }}</strong><p>{{ 'Esta es una inspiración de viaje. Estamos preparando las primeras experiencias; las opciones, fechas y disponibilidad se anunciarán cuando estén confirmadas.'|t }}</p></div><button class="tm4-button tm4-button--primary" type="button" data-tm4-dialog-close>{{ 'Seguir explorando'|t }} {{ icons.icon('arrow') }}</button></div></div></dialog>
