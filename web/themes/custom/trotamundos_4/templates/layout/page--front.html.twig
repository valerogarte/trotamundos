{% import '@trotamundos_4/components/icons.html.twig' as icons %}
<div class="tm4-shell">
{% include '@trotamundos_4/components/header.html.twig' %}
<div class="tm4-page-column"><main id="main-content" tabindex="-1">
  <div class="tm4-topline tm4-container"><span>COLOMBIA / {{ 'CUADERNO DE VIAJE'|t }}</span><a href="#experiencias">{{ 'Ver todos los lugares'|t }} {{ icons.icon('diagonal') }}</a></div>
  <section class="tm4-hero tm4-container" id="atlas" aria-labelledby="tm4-hero-title"><div class="tm4-hero__copy"><p class="tm4-eyebrow"><span>01</span>{{ 'EL ATLAS TROTAMUNDOS'|t }}</p><h1 id="tm4-hero-title">{{ 'Un país.'|t }}<br><span>{{ 'Mil desvíos.'|t }}</span></h1><p class="tm4-hero__description">{{ 'Hay una Colombia que todavía no sale en tus planes. Elige un punto en el mapa y empieza a imaginar tu próximo viaje.'|t }}</p><a class="tm4-button tm4-button--primary" href="#experiencias">{{ 'Abre la bitácora'|t }} {{ icons.icon('arrow') }}</a><p class="tm4-hero__signature">{{ 'Con la mirada de'|t }}<br><strong>{{ 'Juan Trota Mundos.'|t }}</strong></p><div class="tm4-hero__index"><span>{{ 'Pueblos'|t }}</span><span>{{ 'Agua'|t }}</span><span>{{ 'Naturaleza'|t }}</span></div></div>
  <div class="tm4-atlas" data-tm4-atlas><div class="tm4-atlas__heading"><span>{{ 'ELIGE UN PUNTO DE PARTIDA'|t }}</span><span aria-hidden="true">N ↑</span></div><div class="tm4-atlas__drawing"><img class="tm4-atlas__map" src="{{ tm4_path }}/assets/maps/colombia.svg" alt="{{ 'Contorno de Colombia con tres lugares para explorar.'|t }}" width="600" height="660">
      {% for experience in tm4_experiences %}{% if experience.id in ['concepcion', 'cocora', 'rosario'] %}<button class="tm4-map-point{{ experience.id == 'concepcion' ? ' is-active' : '' }} tm4-map-point--{{ experience.id }}" type="button" data-tm4-place="{{ experience.id }}" data-name="{{ experience.name }}" data-region="{{ experience.region }}" data-image="{{ tm4_path }}/assets/images/{{ experience.image }}" data-alt="{{ experience.alt }}" data-dialog="tm4-place-{{ experience.id }}" aria-pressed="{{ experience.id == 'concepcion' ? 'true' : 'false' }}" aria-label="{{ 'Explorar @name en el mapa'|t({'@name': experience.name}) }}"><span>{{ experience.number }}</span><span>{{ experience.name }}</span></button>{% endif %}{% endfor %}
      <span class="tm4-atlas__country" aria-hidden="true">C O L O M B I A</span></div><div class="tm4-atlas__preview"><img src="{{ tm4_path }}/assets/images/concepcion.webp" alt="{{ 'Una calle de Concepción, Antioquia.'|t }}" width="100" height="100" data-tm4-atlas-image><div><span>{{ 'ESTÁS EXPLORANDO'|t }}</span><h2 data-tm4-atlas-title>{{ 'Concepción'|t }}</h2><p data-tm4-atlas-region>{{ 'Antioquia'|t }}</p></div><button type="button" data-tm4-atlas-open data-tm4-dialog-open="tm4-place-concepcion" aria-label="{{ 'Abrir detalle del lugar seleccionado'|t }}">{{ icons.icon('arrow') }}</button></div><p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-tm4-atlas-status></p></div></section>

  {% if page.highlighted %}<div class="tm4-container">{{ page.highlighted }}</div>{% endif %}

  <div class="tm4-roadline"><div class="tm4-container"><span>{{ 'TOMA EL DESVÍO.'|t }}</span>{{ icons.icon('diagonal') }}<span>{{ 'CONOCE EL LUGAR.'|t }}</span>{{ icons.icon('diagonal') }}<span>{{ 'QUÉDATE CON LA HISTORIA.'|t }}</span></div></div>

  <section class="tm4-experiences tm4-container" id="experiencias" aria-labelledby="tm4-experiences-title" data-tm4-experiences><div class="tm4-section-heading"><div><p class="tm4-eyebrow"><span>02</span>{{ 'EL ÍNDICE DE LUGARES'|t }}</p><h2 id="tm4-experiences-title">{{ 'Todavía hay'|t }}<br>{{ 'mucho por ver.'|t }}</h2></div><p>{{ 'Para cuando te apetece cambiar de aire. Una primera colección de pueblos, paisajes y buenas pausas en Colombia.'|t }}</p></div><div class="tm4-catalog-tools"><label class="tm4-search"><span class="visually-hidden">{{ 'Buscar entre los lugares de esta colección'|t }}</span>{{ icons.icon('search') }}<input type="search" data-tm4-search placeholder="{{ 'Busca un lugar o una región'|t }}" autocomplete="off"></label><div class="tm4-filters" role="group" aria-label="{{ 'Filtrar lugares por categoría'|t }}"><button type="button" data-tm4-filter="all" aria-pressed="true">{{ 'Todos'|t }}</button><button type="button" data-tm4-filter="pueblos" aria-pressed="false">{{ 'Pueblos'|t }}</button><button type="button" data-tm4-filter="bienestar" aria-pressed="false">{{ 'Bienestar'|t }}</button><button type="button" data-tm4-filter="naturaleza" aria-pressed="false">{{ 'Naturaleza'|t }}</button></div></div><div class="tm4-catalog-caption"><span>{{ 'FICHAS DE INSPIRACIÓN'|t }}</span><span data-tm4-results>{{ '4 lugares'|t }}</span></div><p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-tm4-status></p><div class="tm4-entry-list" id="destinos">{% for experience in tm4_experiences %}{% include '@trotamundos_4/components/experience-card.html.twig' with {experience: experience} %}{% endfor %}</div><div class="tm4-empty" data-tm4-empty hidden><h3>{{ 'Ese desvío está por descubrir.'|t }}</h3><p>{{ 'Prueba con otro nombre o vuelve a ver toda la colección.'|t }}</p><button class="tm4-button tm4-button--outline" type="button" data-tm4-clear>{{ 'Ver todos los lugares'|t }} {{ icons.icon('arrow') }}</button></div><p class="tm4-experiences__note">{{ 'Estamos preparando nuestras primeras experiencias. Las fechas, los precios y la disponibilidad se anunciarán cuando estén confirmados.'|t }}</p></section>

  <section class="tm4-logbook" id="esencia" aria-labelledby="tm4-logbook-title"><div class="tm4-container"><p class="tm4-eyebrow"><span>03</span>{{ 'NOTAS DEL CAMINO'|t }}</p><div class="tm4-logbook__heading"><h2 id="tm4-logbook-title">{{ 'El mejor plan'|t }}<br>{{ 'también se desvía.'|t }}</h2><p>{{ 'La mirada de Juan Trota Mundos empieza en los detalles: una calle que no conocías, una conversación, un paisaje que te hace parar. Nuestra bitácora se escribe por ahí.'|t }}</p></div><div class="tm4-fieldnotes"><article><span>01 / {{ 'MIRAR'|t }}</span><h3>{{ 'Baja la velocidad.'|t }}</h3><p>{{ 'Deja tiempo para descubrir lo que suele pasar desapercibido.'|t }}</p></article><article><span>02 / {{ 'CONVERSAR'|t }}</span><h3>{{ 'Escucha el lugar.'|t }}</h3><p>{{ 'Sus historias también viven en las personas que lo habitan.'|t }}</p></article><article><span>03 / {{ 'DISFRUTAR'|t }}</span><h3>{{ 'Sigue la curiosidad.'|t }}</h3><p>{{ 'Un buen desvío puede ser el principio de una gran historia.'|t }}</p></article></div></div></section>

  <section class="tm4-checklist tm4-container" id="preguntas" aria-labelledby="tm4-checklist-title"><div><p class="tm4-eyebrow"><span>04</span>{{ 'ANTES DE SALIR'|t }}</p><h2 id="tm4-checklist-title">{{ 'Un par de cosas'|t }}<br>{{ 'para el camino.'|t }}</h2></div><div class="tm4-checklist__items"><details><summary>{{ '¿Qué experiencias estamos preparando?'|t }}{{ icons.icon('plus') }}</summary><p>{{ 'El piloto se está preparando en Concepción y en los termales, con opciones de alojamiento y paquetes. Las demás fichas son lugares para inspirarte.'|t }}</p></details><details><summary>{{ '¿Ya se pueden reservar?'|t }}{{ icons.icon('plus') }}</summary><p>{{ 'Todavía estamos preparando las primeras propuestas. Publicaremos sus fechas, precios y disponibilidad cuando estén confirmados.'|t }}</p></details><details><summary>{{ '¿Qué puedo hacer en este atlas?'|t }}{{ icons.icon('plus') }}</summary><p>{{ 'Elegir un punto del mapa, conocer su historia y explorar la colección por nombre, región o categoría. Es el primer paso para imaginar tu próximo viaje.'|t }}</p></details></div></section>

  <section class="tm4-departure tm4-container" aria-labelledby="tm4-departure-title"><div><span class="tm4-eyebrow">{{ 'SIGUIENTE DESTINO'|t }}</span><h2 id="tm4-departure-title">{{ 'Donde te lleve'|t }}<br>{{ 'la curiosidad.'|t }}</h2></div><a class="tm4-button tm4-button--primary" href="#atlas">{{ 'Vuelve a abrir el mapa'|t }} {{ icons.icon('diagonal') }}</a></section>
  <div class="tm4-container tm4-front-content">{{ page.content|without('trotamundos_4_content', 'system_main') }}</div>
  {% for experience in tm4_experiences %}{% include '@trotamundos_4/components/experience-dialog.html.twig' with {experience: experience} %}{% endfor %}
</main>{% include '@trotamundos_4/components/footer.html.twig' %}</div></div>
