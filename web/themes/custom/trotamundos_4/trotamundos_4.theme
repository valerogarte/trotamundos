<?php

/**
 * @file
 * Presentation hooks for the independent Trotamundos 4 theme.
 */

/**
 * Implements hook_preprocess_html().
 */
function trotamundos_4_preprocess_html(array &$variables): void {
  $variables['tm4_path'] = base_path() . \Drupal::service('extension.list.theme')->getPath('trotamundos_4');
  $variables['attributes']['class'][] = 'tm4-page';
  $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();
  if ($variables['is_front']) {
    $variables['head_title']['title'] = t('Un país. Mil desvíos.');
  }
}

/**
 * Implements hook_preprocess_page().
 */
function trotamundos_4_preprocess_page(array &$variables): void {
  $variables['tm4_path'] = base_path() . \Drupal::service('extension.list.theme')->getPath('trotamundos_4');
  $variables['tm4_experiences'] = _trotamundos_4_experiences();
  $variables['tm4_brand_guide_url'] = \Drupal::moduleHandler()->moduleExists('trotamundos_brand')
    ? \Drupal\Core\Url::fromRoute('trotamundos_brand.guide')->toString()
    : NULL;
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function trotamundos_4_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  if (\Drupal::routeMatch()->getRouteName() === 'trotamundos_brand.guide') {
    $suggestions[] = 'page__brand_guide';
  }
}

